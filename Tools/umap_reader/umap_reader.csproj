<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- CUE4Parse ships its own package versions; do not take this repository's. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- CUE4Parse lives below this directory, so the SDK's recursive globs would otherwise compile its
         sources into this project under this project's settings. It is referenced, not absorbed. -->
    <Compile Remove="CUE4Parse/**" />
    <None Remove="CUE4Parse/**" />
    <EmbeddedResource Remove="CUE4Parse/**" />
    <ProjectReference Include="CUE4Parse/CUE4Parse/CUE4Parse.csproj" />
  </ItemGroup>
</Project>
